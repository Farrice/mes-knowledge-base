{
  "permissions": {
    "allow": [
      "Bash(python3 execution/chain_runner.py finalize *)",
      "Bash(python3 execution/memory_retrieve.py *)",
      "Bash(python3 execution/intent_to_package.py *)",
      "Bash(python3 execution/orchestration_ledger.py *)",
      "Bash(python3 execution/fetch-transcript.py *)",
      "Bash(python3 execution/routing_enforcer.py check *)",
      "Bash(python3 execution/prose_classifier.py check *)",
      "Bash(python3 execution/cost_gate.py check *)",
      "Bash(python3 -m py_compile *)",
      "mcp__claude_ai_Higgsfield__job_status",
      "mcp__claude_ai_Higgsfield__models_explore",
      "mcp__claude_ai_Higgsfield__balance"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/execution/skill_router_hook.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/execution/hooks/session_ledger_hook.py\" prompt",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/execution/hooks/cost_gate_hook.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read|Skill|Write|Edit|NotebookEdit|Task|Agent|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/execution/hooks/session_ledger_hook.py\" posttool",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/execution/hooks/session_ledger_hook.py\" stop",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
