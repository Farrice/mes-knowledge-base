# Environment and credentials
.env
credentials.json
token.json
# MCP server config — contains API tokens injected via `claude mcp add --env`
.mcp.json
# Apify transient flag files
.agent/apify-budget-warning.flag

# Temporary files
.tmp/

# claude.ai data export — private derived data (raw transcripts live under .tmp/ above).
# Redaction is regex-based and imperfect; never commit any of this. Code lives in
# execution/claude_export_*.py; the runbook is docs/claude-export-import.md.
_active/claude-export/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Node
node_modules/

# Build output
out/
dist/
.remotion/

# Chrome profiles
chrome_profile_*/

# Playwright MCP logs
.playwright-mcp/

# Large/generated files
*.mp4
*.pack

# OS files
.DS_Store
Thumbs.db

# Standalone skill files (should be in skills/ directory)
*.skill

# Claude Code local settings (may contain secrets in permission rules)
.claude/settings.local.json

# NBA stats cache (regenerated from API, don't commit)
.agent/nba-cache/

# Chief of Staff OS (/cos) — private founder state: family/health journal,
# life context, goals. NEVER commit (added 2026-07-02, before first content).
.agent/cos/

# Runtime state and telemetry — regenerated every session, never source-of-truth
# (Added 2026-04-25 as part of audit Phase B+ cleanup.)
.agent/session-state.md
.agent/gemini-api-usage.json
.agent/perplexity-usage.json
.agent/notebooklm-usage.json
.agent/apify-usage.json
.agent/revenue-outcomes.json
.agent/evolution_orchestrator.log

# Skill-embeddings cache (regenerable, ~3.6MB — regenerated by the skill embedding pass)
.agent/skill-embeddings.json

# Per-session runtime ledgers (one file per session, written by session_ledger_hook.py)
.agent/sessions/ledger-*.json

# Closeout-spine runtime artifacts (end_session_closeout.py). state-archive/
# holds verbatim copies of .agent/session-state.md, which is deliberately
# never committed (privacy) — must never leak via `git add .`.
.agent/sessions/end-session-memory-ledger.jsonl
.agent/sessions/state-archive/

# Ephemeral intent-tracking state
.agent/intent-memory/

# Sovereign memory store (SQLite — binary, not git-friendly)
# Runtime data: DB + backups + JSONL sidecars are regenerated, never source-of-truth.
.memory/sovereign.db
.memory/sovereign.db-shm
.memory/sovereign.db-wal
.memory/backups/
.memory/events/

# Evolution orchestrator runtime state and queues
evolution_store/orchestrator_state.json
evolution_store/queue/

# Routing/Recall observability traces (append-only JSONL — high-churn)
evolution_store/traces/routing_decisions.jsonl
evolution_store/traces/recall_grounding.jsonl
evolution_store/traces/daily_evolution_*.md
evolution_store/traces/weekly_baseline_*.json

# v2 finalize traces — generated on every chain_runner finalize() call
# (kept ignored going forward; older committed ones remain for historical record)
evolution_store/v2_traces/trace_*.json

# v2 search sets generated by evolution_tracer
evolution_store/v2_search_sets/

# DESIGN.md validation telemetry — append-only JSONL
.agent/design-md-validations.jsonl

# Video-vision sidecar artifacts (regenerable from source URLs via /watch)
# See directives/video-vision-protocol.md
extractions/*/frames/
extractions/*/visual-context.md
extractions/*/download/
.agent/video-vision-log.jsonl

# Andrea Resonance — large PNG hero-shot archives (added 2026-05-28 session cleanup)
# These are render artifacts; keep them local or in cloud storage, not in git
_active/andrea-dj/launch/03-visual-variants/_archive/
_active/andrea-dj/launch/03-visual-variants/variant-b-hero-shots-v3/
_active/andrea-dj/launch/03-visual-variants/variant-c-hero-shots-v3/
.agent/active-tool.lock

# Large local archives (never commit — .git bloat; raw sources live in sovereign.db / original services)
_archive/*.tar.gz
