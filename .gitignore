.agent/health/lane-reconciler.json
.agent/lane-reconciler.log
.agent/health/collector.log
.agent/weekly-cards.log
.agent/catalog/catalog.jsonl
.agent/creative-strategy-learning-events.jsonl
.agent/dara-format-outcomes.jsonl
.agent/health/degradations-runtime.jsonl

# Deterministic scheduled outputs. The runners consume these local files
# directly; they are runtime queue/report state, not repository source truth.
.agent/mission-queue/pending/card-harness-evals-*.md
.agent/mission-queue/pending/card-verdict-to-diff-*.md
.agent/recurring-reports/*-session-closeout-intelligence.md

# Closeout-spine runtime artifacts (end_session_closeout.py). state-archive/
# holds verbatim copies of .agent/session-state.md, which is deliberately
# never committed (privacy) — must never leak via `git add .`.
.agent/sessions/end-session-memory-ledger.jsonl
.agent/sessions/notion-session-memory-outbox.jsonl
.agent/sessions/notion-session-memory-events.jsonl
.agent/sessions/state-archive/

# Ephemeral intent-tracking state
.agent/intent-memory/

# Sovereign memory store (SQLite — binary, not git-friendly)
# Runtime data: DB + backups + JSONL sidecars are regenerated, never source-of-truth.
.memory/sovereign.db
.memory/sovereign.db-shm
.memory/sovereign.db-wal
.memory/backups/
.memory/events/

# Evolution orchestrator runtime state and queues
evolution_store/orchestrator_state.json
evolution_store/queue/

# Routing/Recall observability traces (append-only JSONL — high-churn)
evolution_store/traces/routing_decisions.jsonl
evolution_store/traces/recall_grounding.jsonl
evolution_store/traces/daily_evolution_*.md
evolution_store/traces/weekly_baseline_*.json

# v2 finalize traces — generated on every chain_runner finalize() call
# (kept ignored going forward; older committed ones remain for historical record)
evolution_store/v2_traces/trace_*.json

# v2 search sets generated by evolution_tracer
evolution_store/v2_search_sets/

# DESIGN.md validation telemetry — append-only JSONL
.agent/design-md-validations.jsonl

# Video-vision sidecar artifacts (regenerable from source URLs via /watch)
# See directives/video-vision-protocol.md
extractions/*/frames/
extractions/*/visual-context.md
extractions/*/download/
.agent/video-vision-log.jsonl

# Andrea Resonance — large PNG hero-shot archives (added 2026-05-28 session cleanup)
# These are render artifacts; keep them local or in cloud storage, not in git
_active/clients/andrea-dj/launch/03-visual-variants/_archive/
_active/clients/andrea-dj/launch/03-visual-variants/variant-b-hero-shots-v3/
_active/clients/andrea-dj/launch/03-visual-variants/variant-c-hero-shots-v3/
.agent/active-tool.lock

# Large local archives (never commit — .git bloat; raw sources live in sovereign.db / original services)
_archive/*.tar.gz

# Edit Bay: local binaries + sandboxed clones (2026-08-06)
tools/bin/
_active/video-studio/hyperframes-studio/

# Session lock is per-working-tree RUNTIME state — never tracked (2026-08-06).
# Scar: it was committed, so every `git worktree add` was born holding a phantom
# lock from whichever session last committed it, and session_lock.py claim
# BLOCKED in a brand-new worktree that no session was writing to.
.agent/session.lock

# Worktree lanes (2026-08-06, parallel-session-lanes build).
# .claude/worktrees/ holds full nested checkouts created by EnterWorktree —
# BUG fixed here: they were untracked-but-visible, so a `git add .` in main
# could ingest an entire second checkout.
.claude/worktrees/
# Lane runtime state — registry + merge mutex live in main's .agent, never tracked
# (same class as .agent/session.lock above).
.agent/lanes.json
.agent/lane-merge.lock
.agent/hook-failures.log

# Lane bootstrap symlinks must never be sealed into a lane branch (2026-08-06):
# dir-only patterns (.venv/, .memory/*) do not match SYMLINKS, so `git add -A`
# in a lane was catching them. Bare-name patterns cover both forms.
.memory

# ── Phase 3 lane migration (2026-08-06): high-churn per-tree runtime state ──
# These fork in every worktree lane and guarantee merge conflicts; hooks
# rewrite them on every prompt. Spend/cost files are SYMLINKED into lanes by
# worktree_lane.py bootstrap so budgets stay single-source (no double-spend).
# Same class as .agent/session.lock and .agent/session-state.md above.
