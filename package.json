{
  "name": "google-antigravity",
  "version": "0.1.0",
  "private": true,
  "description": "AI orchestration system. This package.json exists to pin tooling for the design-md / product-design-build skill stack.",
  "scripts": {
    "design:lint": "design.md lint DESIGN.md",
    "design:export:tailwind": "design.md export --format tailwind DESIGN.md",
    "design:export:dtcg": "design.md export --format dtcg DESIGN.md",
    "design:diff": "design.md diff",
    "design:spec": "design.md spec --format markdown",
    "design:rebuild-manifest": "python3 -c 'from execution.design_md_brand_lookup import _rebuild_manifest; _rebuild_manifest()'"
  },
  "devDependencies": {
    "@google/design.md": "*"
  },
  "engines": {
    "node": ">=20"
  }
}
