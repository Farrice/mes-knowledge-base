{% liquid
  assign hero_product = section.settings.hero_product
  assign desktop_image = section.settings.desktop_image
  assign mobile_image = section.settings.mobile_image

  if desktop_image == blank and hero_product != blank
    assign desktop_image = hero_product.images[2] | default: hero_product.featured_image
  endif

  if mobile_image == blank
    assign mobile_image = desktop_image
  endif
%}

<section class="mybpm-editorial-hero mybpm-section mybpm-section--light" aria-labelledby="MybpmHero-{{ section.id }}">
  {% if desktop_image != blank %}
    <div class="mybpm-editorial-hero__media" aria-hidden="true">
      <picture>
        <source
          media="(max-width: 749px)"
          srcset="{{ mobile_image | image_url: width: 900 }} 900w, {{ mobile_image | image_url: width: 1400 }} 1400w"
          sizes="100vw"
        >
        {{ desktop_image
          | image_url: width: 2600
          | image_tag:
            widths: '900, 1400, 1800, 2200, 2600',
            sizes: '100vw',
            loading: 'eager',
            fetchpriority: 'high',
            alt: section.settings.image_alt
        }}
      </picture>
    </div>
  {% endif %}

  <div class="mybpm-editorial-hero__content">
    {% if section.settings.kicker != blank %}
      <p class="mybpm-kicker">{{ section.settings.kicker | escape }}</p>
    {% endif %}
    <h1 id="MybpmHero-{{ section.id }}">{{ section.settings.heading | escape }}</h1>
    {% if section.settings.copy != blank %}
      <div class="mybpm-editorial-hero__copy">{{ section.settings.copy }}</div>
    {% endif %}
    <div class="mybpm-editorial-hero__actions">
      {% if section.settings.primary_label != blank and section.settings.primary_link != blank %}
        <a class="mybpm-button mybpm-button--acid" href="{{ section.settings.primary_link }}">
          {{ section.settings.primary_label | escape }}
        </a>
      {% endif %}
      {% if section.settings.secondary_label != blank and section.settings.secondary_link != blank %}
        <a class="mybpm-button" href="{{ section.settings.secondary_link }}">
          {{ section.settings.secondary_label | escape }}
        </a>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "MyBPM editorial hero",
  "tag": "section",
  "class": "mybpm-editorial-hero-section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "product", "id": "hero_product", "label": "Fallback hero product" },
    { "type": "image_picker", "id": "desktop_image", "label": "Desktop image" },
    { "type": "image_picker", "id": "mobile_image", "label": "Mobile image" },
    { "type": "text", "id": "image_alt", "label": "Image alt text", "default": "MyBPM heavyweight streetwear worn after dark" },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "DROP 001 / SUBLEVEL" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "THE FREQUENCY BELOW THE FLOOR." },
    { "type": "richtext", "id": "copy", "label": "Copy", "default": "<p>Heavyweight streetwear for the people who know what the room feels like when the bass travels through concrete.</p>" },
    { "type": "text", "id": "primary_label", "label": "Primary label", "default": "Shop the drop" },
    { "type": "url", "id": "primary_link", "label": "Primary link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary label", "default": "Read the story" },
    { "type": "url", "id": "secondary_link", "label": "Secondary link" }
  ],
  "presets": [{ "name": "MyBPM editorial hero" }]
}
{% endschema %}
