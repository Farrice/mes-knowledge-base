<section class="mybpm-section mybpm-section--marble" aria-labelledby="MybpmManifesto-{{ section.id }}">
  <div class="mybpm-manifesto">
    <p class="mybpm-kicker">{{ section.settings.kicker | escape }}</p>
    <div>
      <h2 id="MybpmManifesto-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      <div class="mybpm-manifesto__copy">{{ section.settings.copy }}</div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "MyBPM manifesto",
  "tag": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "WHAT WE WEAR AFTER" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "NOT FESTIVAL MERCH. A SIGNAL TO THE PEOPLE WHO WERE THERE." },
    { "type": "richtext", "id": "copy", "label": "Copy", "default": "<p>MyBPM makes clothing for the raver whose identity stays on after the wristband comes off. The references are specific, the garments carry real weight, and the design never has to shout to prove it belongs.</p>" }
  ],
  "presets": [{ "name": "MyBPM manifesto" }]
}
{% endschema %}
