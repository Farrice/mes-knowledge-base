{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Jen social carousel input",
  "type": "object",
  "required": ["system", "series", "handle", "slides"],
  "properties": {
    "system": {"enum": ["after-hours-guide", "sunlit-local-notes", "quiet-home-editorial", "valley-moments", "hidden-address-journal"]},
    "series": {"type": "string", "maxLength": 40},
    "handle": {"type": "string", "maxLength": 30},
    "location": {"type": "string", "maxLength": 50},
    "status": {"enum": ["proof-only", "draft-review", "approved-copy"]},
    "sources": {"type": "array", "items": {"type": "string"}},
    "slides": {
      "type": "array",
      "minItems": 3,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": ["type", "headline", "image"],
        "properties": {
          "type": {"enum": ["cover", "feature", "detail", "close"]},
          "eyebrow": {"type": "string", "maxLength": 40},
          "headline": {"type": "string", "maxLength": 110},
          "accent": {"type": "string", "maxLength": 35},
          "body": {"type": "string", "maxLength": 280},
          "note": {"type": "string", "maxLength": 80},
          "cta": {"type": "string", "maxLength": 100},
          "image": {"type": "string"},
          "insets": {"type": "array", "maxItems": 3, "items": {"type": "string"}}
        }
      }
    }
  }
}
