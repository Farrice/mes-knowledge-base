{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://antigravity.local/schemas/kyle-milligan-speaker-ledger-v1.json",
  "title": "Kyle Milligan source-attribution ledger row",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "row_id",
    "human_ledger_row_ids",
    "source_video_id",
    "source_kind",
    "claim_kind",
    "claim_text",
    "human_signal",
    "speaker_class",
    "truth_class",
    "attribution_basis",
    "attribution_confidence",
    "factual_confidence",
    "source_refs",
    "permitted_uses",
    "forbidden_uses",
    "workflow_targets",
    "dispute_status",
    "dispute_note",
    "review_status"
  ],
  "properties": {
    "schema_version": {"const": "kyle-speaker-ledger/v1"},
    "row_id": {"type": "string", "pattern": "^SL-[0-9]{3}$"},
    "human_ledger_row_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^H-[0-9]{3}$"}
    },
    "source_video_id": {"const": "UFNlbNa2T4w"},
    "source_kind": {"enum": ["SPOKEN", "VISUAL", "SYNTHESIS"]},
    "claim_kind": {"enum": ["METHOD", "PERFORMANCE", "EXAMPLE", "ATTRIBUTION", "VISUAL", "SYNTHESIS"]},
    "claim_text": {"type": "string", "minLength": 8},
    "human_signal": {"type": "string", "minLength": 8},
    "speaker_class": {"enum": ["KYLE", "MATTHEW", "CO_AUTHORED", "VISUAL", "UNRESOLVED"]},
    "truth_class": {"enum": ["OBSERVED", "SELF_REPORTED", "ILLUSTRATIVE", "THIRD_PARTY", "INFERRED"]},
    "attribution_basis": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "attribution_confidence": {"enum": ["HIGH", "MEDIUM", "LOW", "NOT_APPLICABLE"]},
    "factual_confidence": {"enum": ["HIGH", "MEDIUM", "LOW", "NOT_APPLICABLE"]},
    "source_refs": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "permitted_uses": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "forbidden_uses": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "workflow_targets": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "dispute_status": {"enum": ["NONE", "REVIEWED", "UNRESOLVED"]},
    "dispute_note": {"type": "string"},
    "review_status": {"const": "HUMAN_REVIEWED"}
  },
  "allOf": [
    {
      "if": {"properties": {"source_kind": {"const": "SPOKEN"}}},
      "then": {
        "properties": {
          "source_refs": {
            "items": {
              "type": "object",
              "required": [
                "source_path",
                "source_sha256",
                "start_segment_index",
                "end_segment_index",
                "start_segment_id",
                "end_segment_id",
                "requested_start_ms",
                "requested_end_ms",
                "segment_start_ms",
                "segment_end_ms",
                "normalized_excerpt",
                "excerpt_sha256"
              ]
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"source_kind": {"const": "VISUAL"}}},
      "then": {
        "properties": {
          "speaker_class": {"const": "VISUAL"},
          "claim_kind": {"const": "VISUAL"},
          "source_refs": {
            "items": {
              "type": "object",
              "required": ["frame_path", "frame_sha256", "timestamp_ms"]
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"source_kind": {"const": "SYNTHESIS"}}},
      "then": {
        "properties": {
          "truth_class": {"const": "INFERRED"},
          "claim_kind": {"const": "SYNTHESIS"},
          "source_refs": {
            "items": {
              "type": "object",
              "required": ["anchor_row_ids"],
              "properties": {
                "anchor_row_ids": {
                  "type": "array",
                  "minItems": 1,
                  "items": {"type": "string", "pattern": "^SL-[0-9]{3}$"}
                }
              }
            }
          }
        }
      }
    }
  ]
}
