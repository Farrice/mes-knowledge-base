{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "search-event/v1",
  "title": "SearchEvent",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_type", "event_id", "project_id", "content_id", "stage", "observed_at", "evidence_refs", "source_hashes", "provenance"],
  "properties": {
    "schema_version": {"const": "search-event/v1"},
    "record_type": {"const": "SearchEvent"},
    "event_id": {"type": "string"},
    "project_id": {"type": "string"},
    "content_id": {"type": "string"},
    "stage": {"enum": ["PREDICTED", "PUBLISHED", "INDEXED", "RANKED", "CITED", "TRAFFIC", "CONVERTED", "COLLECTED"]},
    "observed_at": {"type": "string", "format": "date-time"},
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "source_hashes": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
    "provenance": {"type": "string", "minLength": 1},
    "value": {},
    "notes": {"type": "string"}
  }
}
