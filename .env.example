# .env — API keys for Antigravity execution scripts.
# Copy to `.env` (gitignored) and fill in real values. Not exhaustive; add
# keys as scripts require them. Never commit the real .env.

# Apify — scraping & social listening ($29/mo Starter plan).
# Get it at https://console.apify.com/account/integrations
# After setting this, run: bash execution/apify_setup.sh
APIFY_TOKEN=apify_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Notion — required for all Notion operations (execution/notion_api.py).
NOTION_API_KEY=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Perplexity — deep research / synthesis ($30/mo budget).
PERPLEXITY_API_KEY=pplx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
